---
const clients = [
  {
    name: "OpenCode",
    setup: "Automatic",
    provider: "Cursor",
    variants: "Native variant picker",
    detail: "The deepest integration: native Cursor variants in OpenCode's model picker, with your current default left untouched."
  },
  {
    name: "Pi",
    setup: "Automatic when installed",
    provider: "Model Ferry",
    variants: "model@variant entries",
    detail: "Model Ferry adds a custom Pi provider and keeps its model catalog in sync without changing your selection."
  },
  {
    name: "Hermes Agent",
    setup: "Automatic when installed",
    provider: "Model Ferry",
    variants: "model@variant entries",
    detail: "A dedicated provider is merged into Hermes while its current provider, model, and YAML settings stay intact."
  }
];
---

<section class="section" id="compatibility">
  <div class="container">
    <span class="kicker">Compatibility</span>
    <h2 class="heading">Made for more than one agent.</h2>
    <p class="sub">
      Use OpenCode today and Pi tomorrow without rebuilding your model setup. Model Ferry scans for more than 40
      known harnesses, configures verified integrations, and gives every compatible client the same local endpoint.
    </p>

    <div class="clients">
      {clients.map((client) => (
        <article class="client">
          <div class="client-head">
            <h3>{client.name}</h3>
            <span class="badge">{client.setup}</span>
          </div>
          <dl>
            <div><dt>Provider</dt><dd>{client.provider}</dd></div>
            <div><dt>Presets</dt><dd><code>{client.variants}</code></dd></div>
          </dl>
          <p>{client.detail}</p>
        </article>
      ))}
    </div>

    <div class="manual">
      <div>
        <span class="manual-label">Your agent, your choice</span>
        <h3>One endpoint for the rest of your stack.</h3>
        <p>Any same-machine agent that accepts a custom OpenAI Chat Completions provider can connect manually. Run <code>modelferry agents</code> to see what Model Ferry found and which integrations it can manage.</p>
      </div>
      <div class="contract">
        <div><span>API</span><code>OpenAI Chat Completions</code></div>
        <div><span>Base URL</span><code>http://127.0.0.1:8791/v1</code></div>
        <div><span>Auth</span><code>Bearer &lt;localToken&gt;</code></div>
      </div>
    </div>
    <p class="manual-note">Provider support varies by harness. Model Ferry never edits an unverified config format. The port can change if 8791 is occupied; run <code>modelferry status</code> for the resolved connection values.</p>
  </div>
</section>

<style>
  .heading { font-size: clamp(30px, 4vw, 44px); max-width: 760px; }
  .sub { max-width: 760px; color: var(--muted); font-size: 17px; margin: 14px 0 40px; }
  .clients { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .client { padding: 24px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); }
  .client-head { display: flex; align-items: center; gap: 12px; justify-content: space-between; }
  .client h3, .manual h3 { font-size: 18px; }
  .badge { flex: none; color: var(--accent); background: var(--accent-soft); border: 1px solid rgba(47, 129, 247, 0.25); border-radius: 999px; padding: 4px 9px; font-size: 11px; font-weight: 600; }
  dl { margin: 22px 0 18px; }
  dl div { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
  dt { color: var(--faint); }
  dd { margin: 0; color: var(--text); text-align: right; }
  dd code { font-size: 12px; }
  .client p, .manual p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.65; }
  .manual { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; margin-top: 16px; padding: 28px; border: 1px solid rgba(47, 129, 247, 0.3); border-radius: var(--radius); background: var(--accent-soft); }
  .manual-label { display: block; color: var(--accent); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px; }
  .manual h3 { margin-bottom: 8px; }
  .contract { border: 1px solid var(--line); border-radius: 12px; background: var(--bg-soft); overflow: hidden; }
  .contract div { display: grid; grid-template-columns: 90px 1fr; gap: 12px; padding: 11px 14px; border-bottom: 1px solid var(--line); font-size: 12px; }
  .contract div:last-child { border-bottom: 0; }
  .contract span { color: var(--faint); }
  .contract code { color: var(--text); overflow-wrap: anywhere; }
  .manual-note { margin: 12px 0 0; color: var(--faint); font-size: 12px; }
  .manual-note code { color: var(--muted); }
  @media (max-width: 900px) { .clients { grid-template-columns: 1fr; } }
  @media (max-width: 720px) { .manual { grid-template-columns: 1fr; gap: 24px; } }
</style>
