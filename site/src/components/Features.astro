---
const features = [
  {
    title: "Full catalog sync",
    body: "Every model and parameter combination available to your Cursor account, discovered through the Cursor Agent SDK and refreshed on a schedule."
  },
  {
    title: "Native variants",
    body: "Cursor's exact thinking, reasoning, effort, context, and fast presets appear as OpenCode variants, switchable from the picker or --variant."
  },
  {
    title: "Zero-credential setup",
    body: "A one-time browser sign-in mints a 90-day key. The bridge renews it automatically before it lapses, so you never handle API keys."
  },
  {
    title: "Background launch agent",
    body: "Starts at login via launchd, so you never see a Keychain unlock prompt after a restart."
  },
  {
    title: "Loopback only",
    body: "Binds to 127.0.0.1 with a per-install bearer token minted on setup. Auth and config routes require that token. Nothing else on your network can reach the bridge."
  },
  {
    title: "OpenCode owns tools",
    body: "Cursor agents get MCP only. Shell, edit, and other Cursor built-ins stay off. OpenCode function tools run in OpenCode, not in the Cursor agent."
  }
];
---
<section class="section" id="features">
  <div class="container">
    <span class="kicker">Features</span>
    <h2 class="heading">Cursor's catalog, native in OpenCode.</h2>
    <p class="sub">Point it at your Cursor account. Models and variants show up in the picker.</p>
    <div class="grid">
      {features.map((feature) => (
        <div class="card">
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .heading { font-size: clamp(30px, 4vw, 44px); max-width: 620px; }
  .sub { color: var(--muted); font-size: 17px; margin: 12px 0 40px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; }
  .card:hover { border-color: var(--line-strong); }
  .card h3 { font-size: 17px; margin-bottom: 8px; }
  .card p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.6; }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
</style>
