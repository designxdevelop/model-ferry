---
const quick = `curl -fsSL https://ferry.designxdevelop.com/install.sh | bash`;
const windows = `irm https://ferry.designxdevelop.com/install.ps1 | iex`;

const manual = `git clone https://github.com/designxdevelop/model-ferry.git
cd model-ferry
npm install
npm run setup`;

const usage = `opencode run -m cursorapi/composer-2.5 \\
  --variant high-standard "Explain this repository"`;
---

<section class="section" id="install">
  <div class="container">
    <span class="kicker">Install</span>
    <h2 class="heading">One command to your first run.</h2>
    <p class="platforms">
      Supported on <strong>macOS</strong>, <strong>Linux</strong>, and <strong>Windows</strong> —
      <code>install.sh</code> on macOS and Linux, <code>install.ps1</code> on Windows.
    </p>
    <div class="code quick">
      <div class="bar"><span>macOS / Linux</span><button class="copy" data-copy="#quick-install" type="button">Copy</button></div>
      <pre><span class="cmt"># install the bridge, sign in, and launch it</span>
<span id="quick-install">{quick}</span></pre>
    </div>
    <div class="code quick">
      <div class="bar"><span>Windows</span><button class="copy" data-copy="#windows-install" type="button">Copy</button></div>
      <pre><span class="cmt"># Windows 10 / 11: install, sign in, and launch</span>
<span id="windows-install">{windows}</span></pre>
    </div>
    <p class="note">
      Clones the repo to <code>~/.modelferry</code>, installs dependencies, and runs setup. Setup signs you in with
      Cursor, installs a login service (<code>launchd</code>, systemd, or Task Scheduler), and adds the
      <code>cursorapi</code> provider to OpenCode. Your default model stays untouched.
    </p>

    <div class="callout">
      <span class="callout-title">Uses your Cursor subscription</span>
      Every request runs through your own Cursor account. Your Cursor usage limits, model eligibility, and
      account terms apply exactly as they would in the Cursor app.
    </div>

    <h3 class="subheading">Manual setup</h3>
    <div class="cols">
      <div class="code">
        <div class="bar"><span>macOS / Linux / Windows</span><button class="copy" data-copy="#manual-install" type="button">Copy</button></div>
        <pre><span class="cmt"># clone, install, and sign in</span>
<span id="manual-install">{manual}</span></pre>
      </div>
      <div class="code">
        <div class="bar">usage</div>
        <pre>{usage}</pre>
      </div>
    </div>
    <p class="note">
      Works on macOS, Linux, and Windows 10/11 with the Cursor Agent SDK and the standard OpenAI-compatible chat API.
      <a href="https://github.com/designxdevelop/model-ferry" target="_blank" rel="noopener">Read the README</a> for the full CLI and catalog-refresh commands.
    </p>
  </div>
</section>

<style>
  .heading { font-size: clamp(30px, 4vw, 44px); margin-bottom: 16px; }
  .platforms { margin: 0 0 28px; color: var(--muted); font-size: 15px; line-height: 1.6; }
  .platforms strong { color: var(--text); font-weight: 600; }
  .platforms code { font-size: 13px; color: var(--text); }
  .subheading { font-size: 20px; margin: 48px 0 16px; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .code { border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-soft); overflow: hidden; }
  .code.quick { margin-bottom: 12px; }
  .callout { margin: 24px 0 0; padding: 16px 20px; border: 1px solid rgba(47, 129, 247, 0.3); border-left: 3px solid var(--accent); border-radius: 12px; background: var(--accent-soft); font-size: 14px; color: var(--muted); line-height: 1.6; }
  .callout-title { display: block; font-weight: 600; color: var(--text); font-size: 14px; margin-bottom: 4px; }
  .code .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 16px; border-bottom: 1px solid var(--line); font-size: 12px; color: var(--faint); font-family: "JetBrains Mono", monospace; }
  .code pre { margin: 0; padding: 18px 20px; font-size: 13px; line-height: 1.8; color: #d7d7db; white-space: pre-wrap; }
  .code .cmt { color: var(--faint); }
  .note { margin-top: 20px; color: var(--muted); font-size: 14px; }
  .note code { font-size: 13px; color: var(--text); }
  .note a { color: var(--accent); text-decoration: none; }
  .note a:hover { text-decoration: underline; }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr; } }
</style>
