---
const steps = [
  {
    n: "01",
    title: "Find your agents",
    body: "One command installs the bridge and scans more than 40 known harnesses. OpenCode, Pi, and Hermes are configured without switching their current models."
  },
  {
    n: "02",
    title: "Sign in",
    body: "A browser opens to Cursor. Complete the sign-in and the Cursor SDK stores a 90-day API key locally. Model Ferry attempts renewal before expiry. Set CURSOR_API_KEY to skip the browser."
  },
  {
    n: "03",
    title: "Choose your interface",
    body: "Use native variants in OpenCode, model@variant entries in Pi or Hermes, or connect another compatible agent to the same local endpoint."
  }
];
---
<section class="section" id="how">
  <div class="container">
    <span class="kicker">How it works</span>
    <h2 class="heading">From your Cursor account to your agent.</h2>
    <div class="steps">
      {steps.map((step) => (
        <div class="step">
          <span class="num">{step.n}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .heading { font-size: clamp(30px, 4vw, 44px); margin-bottom: 44px; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; counter-reset: step; }
  .step { position: relative; padding: 28px 24px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); }
  .step .num { font-family: "JetBrains Mono", monospace; font-size: 13px; color: var(--accent); }
  .step h3 { font-size: 18px; margin: 10px 0 8px; }
  .step p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.65; }
  @media (max-width: 860px) { .steps { grid-template-columns: 1fr; } }
</style>
