---
import FerryMark from "../components/FerryMark.astro";
import Footer from "../components/Footer.astro";

const pageTitle = "Model Ferry · Cursor models in OpenCode";
const description =
  "A loopback-only, OpenAI-compatible bridge for macOS, Linux, and Windows that syncs Cursor's full model catalog into OpenCode as native variants, including reasoning, effort, context, and fast presets.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="Model Ferry" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="nav">
      <a class="brand" href="/">
        <FerryMark size={22} />
        <span>Model Ferry</span>
      </a>
      <nav class="links">
        <a href="#features">Features</a>
        <a href="#how">How it works</a>
        <a href="#install">Install</a>
        <a href="#faq">FAQ</a>
      </nav>
      <a class="btn ghost" href="https://github.com/designxdevelop/model-ferry" target="_blank" rel="noopener">GitHub</a>
    </header>

    <main>
      <slot />
    </main>

    <Footer />

    <script>
      document.querySelectorAll("[data-copy]").forEach((button) => {
        button.addEventListener("click", async () => {
          const target = document.querySelector(button.dataset.copy);
          if (!target) return;
          const text = target.textContent.trim();
          const done = () => {
            const original = button.textContent;
            button.textContent = "Copied";
            button.disabled = true;
            setTimeout(() => {
              button.textContent = original;
              button.disabled = false;
            }, 1500);
          };
          try {
            await navigator.clipboard.writeText(text);
            done();
          } catch {
            try {
              const range = document.createRange();
              range.selectNodeContents(target);
              const selection = window.getSelection();
              selection.removeAllRanges();
              selection.addRange(range);
              document.execCommand("copy");
              selection.removeAllRanges();
              done();
            } catch {}
          }
        });
      });
    </script>

    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #0b0b0c;
        --bg-soft: #101012;
        --card: #141416;
        --line: #1f1f24;
        --line-strong: #2a2a30;
        --text: #f2f2f3;
        --muted: #9a9aa3;
        --faint: #6a6a72;
        --accent: #2f81f7;
        --accent-soft: rgba(47, 129, 247, 0.12);
        --radius: 16px;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Inter", ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      ::selection { background: rgba(47, 129, 247, 0.3); }
      h1, h2, h3 { font-family: "Space Grotesk", "Inter", sans-serif; letter-spacing: -0.02em; line-height: 1.15; margin: 0; }
      a { color: inherit; }
      code, pre { font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace; }
      .nav {
        position: sticky; top: 0; z-index: 20;
        display: flex; align-items: center; gap: 24px;
        padding: 16px 24px; max-width: 1120px; margin: 0 auto;
        backdrop-filter: blur(12px); background: rgba(11, 11, 12, 0.75);
        border-bottom: 1px solid transparent;
      }
      .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 600; font-size: 15px; }
      .brand svg { color: var(--text); }
      .links { display: flex; gap: 22px; margin-left: auto; }
      .links a { color: var(--muted); text-decoration: none; font-size: 14px; }
      .links a:hover { color: var(--text); }
      .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; font-weight: 600; font-size: 14px; border-radius: 10px; padding: 10px 18px; transition: background 0.15s ease, border-color 0.15s ease, transform 0.05s ease; }
      .btn.primary { background: var(--accent); color: #fff; }
      .btn.primary:hover { background: #4b94f8; }
      .btn.primary:active { transform: translateY(1px); }
      .btn.ghost { border: 1px solid var(--line-strong); color: var(--text); }
      .btn.ghost:hover { border-color: #3a3a42; }
      .copy { display: inline-flex; align-items: center; justify-content: center; font-family: "Inter", ui-sans-serif, sans-serif; font-size: 12px; font-weight: 600; color: var(--muted); background: none; border: 1px solid var(--line-strong); border-radius: 8px; padding: 4px 10px; cursor: pointer; transition: color 0.15s ease, border-color 0.15s ease; }
      .copy:hover { color: var(--text); border-color: #3a3a42; }
      .copy:disabled { opacity: 0.6; cursor: default; }
      .container { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
      .section { padding: 96px 0; }
      .kicker { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--accent); background: var(--accent-soft); border: 1px solid rgba(47, 129, 247, 0.25); padding: 6px 12px; border-radius: 999px; margin-bottom: 20px; }
      .kicker::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
      @media (max-width: 720px) {
        .links { display: none; }
        .section { padding: 64px 0; }
        .nav .btn.ghost { display: none; }
      }
    </style>
  </body>
</html>
